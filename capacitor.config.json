{
  "appId": "com.yourcompany.habitstreak",
  "appName": "Habit Streak",
  "webDir": "www",
  "bundledWebRuntime": false,
  "backgroundColor": "#6750A4",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#6750A4",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_habit",
      "iconColor": "#6750A4"
    }
  }
}
